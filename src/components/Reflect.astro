---
import { reflectionsFor } from '../data/reflections';

interface Props { topic: string }
const { topic } = Astro.props;
const items = reflectionsFor(topic);
---

{
  items.length > 0 && (
    <section class="reflect">
      <div class="reflect__head">
        <span class="label">Sit with these</span>
        <a class="reflect__all" href={`/reflect#${topic}`}>Answer them privately &rarr;</a>
      </div>
      <ol>
        {items.map((r) => (
          <li>{r.q}</li>
        ))}
      </ol>
    </section>
  )
}

<style>
  .reflect {
    grid-column: main;
    margin-top: 3rem;
    padding: 1.6rem 0 0.4rem;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .reflect__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.2rem;
  }
  .reflect__all {
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }
  .reflect__all:hover { color: var(--human); }
  ol { list-style: none; margin: 0; padding: 0 0 1.2rem; }
  li {
    font-family: var(--display);
    font-size: 1.12rem;
    font-weight: 420;
    line-height: 1.42;
    letter-spacing: -0.006em;
    color: var(--ink);
    padding: 0.85rem 0 0.85rem 1.6rem;
    position: relative;
    max-width: 54ch;
  }
  li + li { border-top: 1px solid var(--rule); }
  li::before {
    content: '?';
    position: absolute;
    left: 0;
    top: 0.9rem;
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--human);
  }
</style>
