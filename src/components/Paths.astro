---
import { PATHS } from '../data/paths';
---
<section class="paths">
  <div class="eyebrow"><span class="label">Where to start</span></div>
  <p class="paths__intro">
    Eleven essays is a lot to walk into cold. These are routes through it,
    depending on why you are here.
  </p>
  <div class="paths__grid">
    {
      PATHS.map((p) => (
        <article class="path">
          <header>
            <h3>{p.name}</h3>
            <span class="label path__min">~{p.minutes} min</span>
          </header>
          <p class="path__who">{p.who}</p>
          <ol>
            {p.steps.map((s, i) => (
              <li>
                <a href={s.slug ? `/topics/${s.slug}` : s.page}>
                  <span class="path__n">{i + 1}</span>
                  <span>
                    <strong>{s.label}</strong>
                    <em>{s.why}</em>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </article>
      ))
    }
  </div>
</section>

<style>
  .paths { padding-block: clamp(2.5rem, 6vw, 4rem) 1rem; }
  .paths__intro { color: var(--ink-soft); max-width: 52ch; margin-bottom: 2.4rem; }
  .paths__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  .path { background: var(--paper); padding: 1.5rem 1.4rem; }
  .path header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.8rem;
    margin-bottom: 0.5rem;
  }
  .path h3 {
    font-family: var(--display);
    font-size: 1.12rem;
    font-weight: 570;
    letter-spacing: -0.008em;
    max-width: 20ch;
  }
  .path__min { flex: none; }
  .path__who {
    color: var(--ink-soft);
    font-size: 0.93rem;
    line-height: 1.5;
    margin-bottom: 1.1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
  }
  .path ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.2rem; }
  .path a {
    display: grid;
    grid-template-columns: 1.4rem 1fr;
    gap: 0.6rem;
    text-decoration: none;
    padding: 0.5rem 0.4rem 0.5rem 0;
    transition: background 0.2s var(--ease), padding-left 0.2s var(--ease);
  }
  .path a:hover { background: var(--paper-raised); padding-left: 0.4rem; }
  .path__n {
    font-family: var(--mono);
    font-size: var(--t-micro);
    color: var(--human);
    padding-top: 0.3em;
  }
  .path strong {
    display: block;
    font-weight: 600;
    font-size: 0.99rem;
    margin-bottom: 0.15rem;
    transition: color 0.2s var(--ease);
  }
  .path a:hover strong { color: var(--human); }
  .path em {
    display: block;
    font-style: normal;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--ink-faint);
  }
</style>
