---
interface Props {
  /** Rung numbers (1–5) to emphasise for this topic. */
  highlight?: number[];
  /** Per-topic override of each rung's example text, keyed by rung number. */
  notes?: Record<number, string>;
  compact?: boolean;
  caption?: string;
}
const { highlight = [], notes = {}, compact = false, caption } = Astro.props;

const RUNGS = [
  { n: 1, name: 'Cede',        who: 'Machine',     gloss: 'The machine does it. You never see the work.' },
  { n: 2, name: 'Approve',     who: 'Machine-led', gloss: 'The machine drafts. You review and sign.' },
  { n: 3, name: 'Collaborate', who: 'Shared',      gloss: 'You and the machine work the problem together.' },
  { n: 4, name: 'Critique',    who: 'Human-led',   gloss: 'You do the work first, unaided. Then ask the machine to attack it.' },
  { n: 5, name: 'Reserve',     who: 'Human',       gloss: 'You do it alone, on purpose, knowing help exists.' },
];
---

<figure class:list={['ladder', { 'is-compact': compact }]}>
  <ol class="ladder__list">
    {
      RUNGS.map((r, i) => (
        <li
          class:list={['rung', { 'is-on': highlight.includes(r.n) }]}
          style={`--mix:${(i / (RUNGS.length - 1)) * 100}%`}
        >
          <span class="rung__n">{String(r.n)}</span>
          <span class="rung__bar" aria-hidden="true" />
          <div class="rung__body">
            <span class="rung__name">
              {r.name}
              <span class="rung__who">{r.who}</span>
            </span>
            <p class="rung__gloss">{r.gloss}</p>
            {notes[r.n] && <p class="rung__note">{notes[r.n]}</p>}
          </div>
        </li>
      ))
    }
  </ol>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .ladder { grid-column: full; margin: 2.6rem 0; }
  .ladder__list {
    list-style: none; margin: 0; padding: 0;
    border-top: 1px solid var(--rule);
  }
  .rung {
    display: grid;
    grid-template-columns: 2rem 3px 1fr;
    gap: 0 1rem;
    align-items: start;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--rule);
    transition: background 0.3s var(--ease);
  }
  .rung__n {
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: 0.08em;
    padding-top: 0.42em;
    color: var(--ink-faint);
    font-variant-numeric: lining-nums;
  }
  .rung__bar {
    align-self: stretch;
    min-height: 2.6rem;
    /* Interpolates teal (machine) → sienna (human) down the ladder. */
    background: color-mix(in oklab, var(--human) var(--mix), var(--machine));
    opacity: 0.5;
    transition: opacity 0.3s var(--ease);
  }
  .rung__name {
    display: flex;
    font-family: var(--display);
    font-size: 1.1rem;
    font-weight: 560;
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    flex-wrap: wrap;
    margin-bottom: 0.25rem;
  }
  .rung__who {
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--human) var(--mix), var(--machine));
    font-weight: 500;
  }
  .rung__gloss {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.97rem;
    line-height: 1.5;
    max-width: 52ch;
  }
  .rung__note {
    margin: 0.55rem 0 0;
    font-family: var(--mono);
    font-size: var(--t-small);
    line-height: 1.5;
    color: var(--ink);
    max-width: 58ch;
    padding-left: 0.85rem;
    border-left: 1px solid var(--rule-strong);
  }
  .rung.is-on { background: color-mix(in srgb, var(--paper-raised) 70%, transparent); }
  .rung.is-on .rung__bar { opacity: 1; }
  .rung.is-on .rung__n { color: var(--ink); }

  .is-compact .rung { padding: 0.7rem 0; }
  .is-compact .rung__gloss { display: none; }

  figcaption {
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: 0.06em;
    color: var(--ink-faint);
    margin-top: 0.9rem;
    line-height: 1.6;
  }
</style>
