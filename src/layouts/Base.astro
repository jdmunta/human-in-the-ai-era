---
import '../styles/global.css';
import { PRACTICES } from '../data/practices';
import { REFLECTION_TOTAL } from '../data/reflections';
import SearchButton from '../components/SearchButton.astro';
import SearchOverlay from '../components/SearchOverlay.astro';

interface Props {
  title: string;
  description: string;
  progress?: boolean;
  /** Slug of the pre-rendered share card in /og. Falls back to the site card. */
  ogSlug?: string;
  /** Structured data for this page, serialised into a JSON-LD script. */
  jsonLd?: Record<string, unknown>;
}
const { title, description, progress = false, ogSlug = 'default', jsonLd } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/topics', label: 'Topics' },
  { href: '/playbook', label: 'Playbook' },
  { href: '/ladder', label: 'The Ladder', optional: true },
  { href: '/audit', label: 'Audit' },
  { href: '/you', label: 'You', optional: true },
  { href: '/about', label: 'About', optional: true },
];
const canonical = new URL(Astro.url.pathname, Astro.site);
const nPractices = PRACTICES.filter((p) => p.inPlaybook).length;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Human in the AI Era" />
    <meta property="og:image" content={new URL(`/og/${ogSlug}.png`, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(`/og/${ogSlug}.png`, Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Human in the AI Era" href="/rss.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <link rel="preload" as="font" type="font/woff2" href="/fonts/newsreader-var.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/fraunces-var.woff2" crossorigin />
    <meta name="theme-color" content="#f2eee4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#100f0c" media="(prefers-color-scheme: dark)" />

    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23f2eee4'/%3E%3Ccircle cx='16' cy='16' r='7' fill='none' stroke='%23a8391a' stroke-width='2.5'/%3E%3Cpath d='M16 2v6M16 24v6' stroke='%231d5551' stroke-width='2.5'/%3E%3C/svg%3E"
    />

    <script is:inline>
      // Set theme before paint to avoid a flash.
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <a class="skiplink" href="#main">Skip to content</a>
    {progress && <div class="progress" id="progress"></div>}

    <div class="shell">
      <header class="masthead">
        <div class="wrap masthead__inner">
          <a class="masthead__logo" href="/">
            Human <em>·</em><span class="masthead__logo-rest">in the AI Era</span>
          </a>
          <nav class="masthead__nav" aria-label="Primary">
            {
              nav.map((n) => (
                <a
                  href={n.href}
                  class={n.optional ? 'is-optional' : undefined}
                  aria-current={path.startsWith(n.href) ? 'page' : undefined}
                >
                  {n.label}
                </a>
              ))
            }
            <SearchButton />
            <button
              class="themetoggle"
              id="themetoggle"
              type="button"
              aria-label="Toggle colour theme"
              title="Toggle colour theme"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
              </svg>
            </button>
          </nav>
        </div>
      </header>

      <main id="main" tabindex="-1">
        <span id="top"></span>
        <slot />
      </main>

      <footer class="colophon">
        <div class="wrap colophon__grid">
          <div>
            <p class="label" style="margin-bottom:0.8rem">Human in the AI Era</p>
            <p style="font-size:0.92rem; line-height:1.55; max-width:24rem">
              A working argument about what humans keep, what we deliberately
              refuse to hand over, and how we rebuild meaning when cognition is
              cheap.
            </p>
          </div>
          <div>
            <p class="label" style="margin-bottom:0.9rem">Read</p>
            <ul>
              <li><a href="/topics">All topics</a></li>
              <li><a href="/contrast">Human vs machine, in diagrams</a></li>
              <li><a href="/map">The argument map</a></li>
              <li><a href="/read">The whole argument, one page</a></li>
              <li><a href="/playbook">The Playbook &mdash; {nPractices} practices</a></li>
              <li><a href="/judging">The Judgment Checklist</a></li>
              <li><a href="/reflect">Reflect &mdash; {REFLECTION_TOTAL} questions</a></li>
              <li><a href="/you">Where you stand</a></li>
              <li><a href="/ladder">The Delegation Ladder</a></li>
              <li><a href="/audit">Cognitive Autonomy Audit</a></li>
              <li><a href="/glossary">Glossary</a></li>
              <li><a href="/topics/steelman">The case against this site</a></li>
            </ul>
          </div>
          <div>
            <p class="label" style="margin-bottom:0.9rem">Project</p>
            <ul>
              <li>
                <a href="https://github.com/jdmunta/human-in-the-ai-era" rel="noopener">
                  Source on GitHub
                </a>
              </li>
              <li><a href="/about">About &amp; method</a></li>
              <li><a href="/about#sources">Sources</a></li>
              <li><a href="/rss.xml">RSS feed</a></li>
            </ul>
          </div>
          <div>
            <p class="label" style="margin-bottom:0.9rem">Colophon</p>
            <p style="font-size:0.86rem; line-height:1.6">
              Set in Fraunces, Newsreader and IBM&nbsp;Plex&nbsp;Mono.
              Built with Astro. Deployed on Railway.
            </p>
          </div>
        </div>
      </footer>
    </div>

    <SearchOverlay />

    <script is:inline>
      (function () {
        var btn = document.getElementById('themetoggle');
        if (btn) {
          btn.addEventListener('click', function () {
            var root = document.documentElement;
            var current =
              root.getAttribute('data-theme') ||
              (window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light');
            var next = current === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-theme', next);
            try { localStorage.setItem('theme', next); } catch (e) {}
          });
        }

        // Give every section heading a hover-revealed permalink.
        var heads = document.querySelectorAll('.prose > h2[id]');
        Array.prototype.forEach.call(heads, function (h) {
          var a = document.createElement('a');
          a.className = 'anchor';
          a.href = '#' + h.id;
          a.setAttribute('aria-label', 'Link to this section');
          a.textContent = '#';
          h.insertBefore(a, h.firstChild);
        });

        var bar = document.getElementById('progress');
        if (bar) {
          var tick = function () {
            var h = document.documentElement;
            var max = h.scrollHeight - h.clientHeight;
            var pct = max > 0 ? (h.scrollTop / max) * 100 : 0;
            bar.style.width = pct + '%';
          };
          document.addEventListener('scroll', tick, { passive: true });
          tick();
        }
      })();
    </script>
  </body>
</html>
