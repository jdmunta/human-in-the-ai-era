---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  progress?: boolean;
}
const { title, description, progress = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/topics', label: 'Topics' },
  { href: '/ladder', label: 'The Ladder', optional: true },
  { href: '/audit', label: 'Audit' },
  { href: '/about', label: 'About', optional: true },
];
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,300..700,0..100,0..1&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..500&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />

    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23f2eee4'/%3E%3Ccircle cx='16' cy='16' r='7' fill='none' stroke='%23a8391a' stroke-width='2.5'/%3E%3Cpath d='M16 2v6M16 24v6' stroke='%231d5551' stroke-width='2.5'/%3E%3C/svg%3E"
    />

    <script is:inline>
      // Set theme before paint to avoid a flash.
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    {progress && <div class="progress" id="progress"></div>}

    <div class="shell">
      <header class="masthead">
        <div class="wrap masthead__inner">
          <a class="masthead__logo" href="/">
            Human <em>·</em> in the AI Era
          </a>
          <nav class="masthead__nav" aria-label="Primary">
            {
              nav.map((n) => (
                <a
                  href={n.href}
                  class={n.optional ? 'is-optional' : undefined}
                  aria-current={path.startsWith(n.href) ? 'page' : undefined}
                >
                  {n.label}
                </a>
              ))
            }
            <button
              class="themetoggle"
              id="themetoggle"
              type="button"
              aria-label="Toggle colour theme"
              title="Toggle colour theme"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
              </svg>
            </button>
          </nav>
        </div>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="colophon">
        <div class="wrap colophon__grid">
          <div>
            <p class="label" style="margin-bottom:0.8rem">Human in the AI Era</p>
            <p style="font-size:0.92rem; line-height:1.55; max-width:24rem">
              A working argument about what humans keep, what we deliberately
              refuse to hand over, and how we rebuild meaning when cognition is
              cheap.
            </p>
          </div>
          <div>
            <p class="label" style="margin-bottom:0.9rem">Read</p>
            <ul>
              <li><a href="/topics">All topics</a></li>
              <li><a href="/ladder">The Delegation Ladder</a></li>
              <li><a href="/audit">Cognitive Autonomy Audit</a></li>
              <li><a href="/topics/steelman">The case against this site</a></li>
            </ul>
          </div>
          <div>
            <p class="label" style="margin-bottom:0.9rem">Project</p>
            <ul>
              <li>
                <a href="https://github.com/jdmunta/human-in-the-ai-era" rel="noopener">
                  Source on GitHub
                </a>
              </li>
              <li><a href="/about">About &amp; method</a></li>
              <li><a href="/about#sources">Sources</a></li>
            </ul>
          </div>
          <div>
            <p class="label" style="margin-bottom:0.9rem">Colophon</p>
            <p style="font-size:0.86rem; line-height:1.6">
              Set in Fraunces, Newsreader and IBM&nbsp;Plex&nbsp;Mono.
              Built with Astro. Deployed on Railway.
            </p>
          </div>
        </div>
      </footer>
    </div>

    <script is:inline>
      (function () {
        var btn = document.getElementById('themetoggle');
        if (btn) {
          btn.addEventListener('click', function () {
            var root = document.documentElement;
            var current =
              root.getAttribute('data-theme') ||
              (window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light');
            var next = current === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-theme', next);
            try { localStorage.setItem('theme', next); } catch (e) {}
          });
        }

        var bar = document.getElementById('progress');
        if (bar) {
          var tick = function () {
            var h = document.documentElement;
            var max = h.scrollHeight - h.clientHeight;
            var pct = max > 0 ? (h.scrollTop / max) * 100 : 0;
            bar.style.width = pct + '%';
          };
          document.addEventListener('scroll', tick, { passive: true });
          tick();
        }
      })();
    </script>
  </body>
</html>
